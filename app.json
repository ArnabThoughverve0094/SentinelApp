{
  "expo": {
    "name": "IronEx",
    "slug": "frontend",
    "version": "1.3.2",
    "orientation": "portrait",
    "icon": "./assets/images/new_logo.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.thoughtverve.sentinel",
      "icon": "./assets/images/new_logo.png",
      "googleServicesFile": "./GoogleService-Info.plist",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSCameraUsageDescription": "This app uses the camera to capture images for uploading documents and profile pictures, such as taking a photo to create post.",
        "NSPhotoLibraryUsageDescription": "This app allows you to select images from your photo library to upload documents or profile pictures, such as choosing a image.",
        "NSPhotoLibraryAddUsageDescription": "This app saves images to your photo library when you download reports or images."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/new_logo.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "in.thoughtverve.sentinel",
      "icon": "./assets/images/new_logo.png",
      "useNextNotificationsApi": true,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./withCrashlyticsFixed",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/new_logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/new_logo.png",
          "color": "#ffffff"
        }
      ],
      "react-native-compressor",
      "expo-font",
      "expo-video",
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      "@react-native-firebase/crashlytics",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0",
            "ndkVersion": "28.0.12433566"
          },
          "ios": {
            "useFrameworks": "static",
            "forceStaticLinking": [
              "RNFBApp",
              "RNFBMessaging",
              "RNFBCrashlytics",
              "FirebaseCore"
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7929b56b-fdaf-4894-9b78-3e25f380baee"
      }
    }
  }
}
